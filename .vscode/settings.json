{
    "go.useLanguageServer": true,
    "gopls": {
        "formatting.gofumpt": true,
        "ui.semanticTokens": true
    },
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
        "source.organizeImports": "explicit"
    },
    "[proto3]": {
        "editor.defaultFormatter": "DrBlury.protobuf-vsc"
    }
}